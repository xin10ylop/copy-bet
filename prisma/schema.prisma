// CopyBet data model (Postgres).
// DATABASE_URL: pooled connection (used by the app).
// DATABASE_URL_UNPOOLED: direct connection (used by migrations). Neon on Vercel sets both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// A Polymarket sports bettor (proxy wallet) we track.
model Bettor {
  address        String   @id // lowercase 0x… proxy wallet
  name           String?
  pseudonym      String?
  profileImage   String?
  xUsername      String?
  verified       Boolean  @default(false)
  /// Market makers / two-sided bots are hidden from rankings.
  isMarketMaker  Boolean  @default(false)
  lbPnlMonth     Float?
  lbPnlAll       Float?
  lbVolumeAll    Float?
  /// all open sports positions (only the largest are stored individually)
  openCount      Int      @default(0)
  /// history longer than we could read: all-time figures cover the most recent positions only
  historyTruncated Boolean @default(false)
  lastIndexedAt  DateTime?
  createdAt      DateTime @default(now())

  bets      SettledBet[]
  daily     DailyStat[]
  positions OpenPosition[]
  follows   Follow[]
}

/// Settled-bet totals per bettor × day × sport × timing. All ranking and profile
/// stats come from here: one small row replaces many bets, which keeps the
/// database small enough for a free Postgres plan.
model DailyStat {
  bettorId String
  day      Int // days since 1970-01-01 (UTC), from the bet's settle time
  sport    String
  timing   String
  bets     Int
  wins     Int
  staked   Float
  profit   Float
  /// bets per lead-time bucket (see LEAD_EDGES), for "typically X before the game" over any filter
  leadHist Int[]   @default([])

  bettor Bettor @relation(fields: [bettorId], references: [address], onDelete: Cascade)

  @@id([bettorId, day, sport, timing])
  @@index([day])
}

/// One settled bet = one market outcome the bettor bought, now resolved or sold.
/// Only each bettor's most recent bets are kept (for "Recent results" and timing hints).
model SettledBet {
  id          String   @id // bettor:condition:outcomeIndex
  bettorId    String
  sport       String // sport group key, e.g. "basketball"
  league      String // league code, e.g. "nba"
  eventSlug   String
  title       String
  outcome     String
  cost        Float // USD staked
  pnl         Float // USD profit (negative = loss)
  entryAt     DateTime
  settledAt   DateTime
  /// epoch seconds copy of settledAt, used by raw aggregate queries
  settledTs   Int
  gameStartAt DateTime?
  leadMinutes Int? // minutes between first entry and game start (negative = in-game)
  timing      String // early | day | late | live | futures
  icon        String?

  bettor Bettor @relation(fields: [bettorId], references: [address], onDelete: Cascade)

  @@index([bettorId, settledTs])
  @@index([sport, settledTs])
}

model OpenPosition {
  id           String    @id // bettor:token
  bettorId     String
  sport        String
  league       String
  eventSlug    String
  title        String
  outcome      String
  /// position of the answer in the market's outcome list (0 = the side named in the title)
  outcomeIndex Int?
  size         Float
  avgPrice     Float
  cost         Float
  currentValue Float
  pnl          Float
  entryAt      DateTime
  gameStartAt  DateTime?
  timing       String
  icon         String?

  bettor Bettor @relation(fields: [bettorId], references: [address], onDelete: Cascade)

  @@index([bettorId])
}

/// Cached Gamma event metadata (game start time, sport).
model EventMeta {
  slug        String    @id
  title       String?
  league      String?
  isGame      Boolean   @default(false)
  startTime   DateTime?
  /// sport from Polymarket's own event tags ("" = not a sports event, null = not looked up yet)
  sport       String?
  fetchedAt   DateTime  @default(now())
}

model User {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  plan             String    @default("free") // free | pro
  telegramChatId   String?   @unique
  telegramUsername String?
  telegramName     String?
  linkToken        String    @unique @default(cuid())
  /// Answers from onboarding bucket questions.
  goal             String?
  favoriteSport    String?

  follows  Follow[]
  searches SavedSearch[]
  alerts   AlertLog[]
}

/// A bettor in a user's portfolio, plus which of their bets to alert on.
model Follow {
  id           String    @id @default(cuid())
  userId       String
  bettorId     String
  /// "all" = every bet, "custom" = only bets matching the rules below.
  mode         String    @default("all")
  sports       String    @default("[]") // JSON array of sport keys
  timing       String    @default("[]") // JSON array of timing keys
  minSize      Float     @default(0) // USD
  includeSells Boolean   @default(false)
  mutedUntil   DateTime?
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bettor Bettor @relation(fields: [bettorId], references: [address], onDelete: Cascade)

  @@unique([userId, bettorId])
  @@index([bettorId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filter    String // JSON BettorFilter
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Every bet we detected from a followed bettor, and who we told.
model AlertLog {
  id        String   @id @default(cuid())
  userId    String
  bettorId  String
  txHash    String
  title     String
  outcome   String
  outcomeIndex Int?
  side      String
  price     Float
  usdSize   Float
  eventSlug String
  sport     String?
  detectedAt DateTime @default(now())
  sendAt    DateTime // free plan sends later
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bettorId, txHash, outcome, side])
  @@index([sentAt, sendAt])
  @@index([userId, detectedAt])
}

/// Results of the continuous self-checks (worker) and status signals. Kept for a week.
model AuditCheck {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  /// "bettor" (consistency after a refresh), "recompute" (vs Polymarket raw data), "rankings" (a filter combination), "heartbeat"
  kind    String
  subject String
  ok      Boolean
  issues  String[]

  @@index([at])
  @@index([kind, at])
}

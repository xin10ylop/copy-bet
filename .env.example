# Database. SQLite for local dev; for production use Postgres and change
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Public URL of the web app (used in Telegram buttons).
APP_URL="http://localhost:3000"

# Telegram bot (create one with @BotFather). Without a token the worker runs in dry-run mode.
TELEGRAM_BOT_TOKEN=""
# Bot username without @, used for the "Connect Telegram" deep link in the web app.
TELEGRAM_BOT_USERNAME=""

# Optional: checkout link for Pro (e.g. a Stripe Payment Link). The user id is appended
# as client_reference_id so a webhook can upgrade the right account.
NEXT_PUBLIC_PRO_CHECKOUT_URL=""

# Set to 0 to stop the worker from re-indexing leaderboards every hour.
INDEX_LEADERBOARDS="1"
